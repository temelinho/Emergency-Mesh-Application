<?xml version="1.0" encoding="utf-8"?>
<!-- Kişiye Özel Mesajlaşma — Tema Uyumlu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ── Header ─────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:background="?attr/colorSurface"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/btnDmBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_chevron"
            app:tint="?android:attr/textColorPrimary" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/avatar_circle_blue" />

            <TextView
                android:id="@+id/tvDmAvatarLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="?"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDmPeerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Özel Mesaj"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtDmMessageCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uçtan uca şifreli 🔒"
                android:textColor="#4CAF50"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardCornerRadius="19dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeColor="@color/colorAccent"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <ImageButton
                android:id="@+id/btnDmNewContact"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/colorAccent" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ── Mesaj Listesi ───────────────────────────────────────────────────── -->
    <ListView
        android:id="@+id/listDmMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clipToPadding="false"
        android:transcriptMode="alwaysScroll" />

    <!-- ── Input Alanı ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/chat_input_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/editDmMessage"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Özel mesaj yaz..."
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:padding="12dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorHint"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnDmSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:fabSize="normal"
            app:backgroundTint="@color/colorPrimary"
            app:tint="@color/white"
            android:src="@android:drawable/ic_menu_send"
            app:elevation="4dp"
            app:pressedTranslationZ="6dp" />
    </LinearLayout>

</LinearLayout>
