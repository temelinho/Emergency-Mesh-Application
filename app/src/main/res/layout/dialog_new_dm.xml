<?xml version="1.0" encoding="utf-8"?>
<!-- Yeni DM konuşması başlatma dialog'u -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 Daha önce konuşulanlar:"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <!-- Daha önce mesajlaşılan kişiler -->
    <ListView
        android:id="@+id/lvDmContacts"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:divider="#333333"
        android:dividerHeight="1dp"
        android:background="#1A1A1A" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Veya yeni bir kullanıcı ID'si girin:"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/editNewDmPeerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Kullanıcı Node ID'si"
        android:inputType="text"
        android:textSize="14sp"
        android:padding="10dp" />

    <EditText
        android:id="@+id/editNewDmPeerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Görünen isim (opsiyonel)"
        android:inputType="textPersonName"
        android:textSize="14sp"
        android:padding="10dp"
        android:layout_marginTop="4dp" />

</LinearLayout>
