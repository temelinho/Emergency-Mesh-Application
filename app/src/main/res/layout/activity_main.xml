<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <!-- ARKA PLAN: Başlık ve Butonlar (Scroll edilebilir arka plan) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="36dp">

        <!-- Header Area -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="AFET ACİL AĞ"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="?attr/textSizeH1"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/txtNodeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="0 düğüm"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="?attr/textSizeSmall" />

                <!-- Şık Ayarlar / Profil Butonu -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardBackgroundColor="#2A2A2A"
                    app:strokeColor="#4D4D4D"
                    app:strokeWidth="1dp"
                    app:cardElevation="2dp">

                    <ImageButton
                        android:id="@+id/btnSettings"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_preferences"
                        app:tint="#E0E0E0" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/txtNodeId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="NodeId: -"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <!-- Status Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtBleStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BLE: -"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtWifiStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WiFi-D: -"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtInternetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NET: -"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Error/Warning Text -->
        <TextView
            android:id="@+id/txtStatusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text=""
            android:textColor="#FF5722"
            android:textSize="10sp" />

        <!-- Action Buttons (Tactical Pulse Button) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="24dp">

            <!-- Background subtle glow/pulse circle -->
            <View
                android:id="@+id/pulseBackground"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_pulse_bg"
                android:alpha="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergency"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/colorPrimary"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="ACİL\nMOD"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold"
                app:cornerRadius="80dp"
                app:rippleColor="@color/white" />

        </FrameLayout>

        <!-- Secondary Sync Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncAll"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="?attr/colorSurface"
            app:strokeColor="@color/text_secondary"
            app:strokeWidth="1dp"
            android:text="AĞ BİLGİSİNİ GÜNCELLE"
            android:textColor="?android:attr/textColorPrimary"
            app:cornerRadius="12dp" />

        <!-- Siren Button (Long Press 3s) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiren"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#B71C1C"
            app:icon="@android:drawable/ic_lock_idle_alarm"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            android:text="SİREN ÇAL"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="?attr/textSizeBody"
            app:cornerRadius="16dp"
            android:elevation="4dp" />

        <!-- Mesaj Kutusu Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChat"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/colorPrimary"
            app:icon="@android:drawable/ic_dialog_email"
            app:iconTint="@color/black"
            app:iconGravity="textStart"
            android:text="MESAJ KUTUSU"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="?attr/textSizeBody"
            app:cornerRadius="16dp"
            android:elevation="4dp" />

        <!-- Status Grid (Tactical: Dark Backgrounds, High-Contrast Icons) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:columnOrderPreserved="false"
            android:rowCount="3">

            <!-- Button 1: Safe -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSafe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:strokeColor="@color/text_hint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✔"
                        android:textColor="@color/status_safe"
                        android:textSize="36sp" 
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/status_safe_text"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="?attr/textSizeBody"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Button 2: Danger -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDanger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_hint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨"
                        android:textColor="@color/status_danger"
                        android:textSize="36sp" 
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/status_help_text"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="?attr/textSizeBody"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Button 3: Help -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHelp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_hint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠"
                        android:textColor="@color/status_help"
                        android:textSize="36sp" 
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Yardım / Destek"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="?attr/textSizeBody"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Button 4: Debris -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDebris"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_hint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏠"
                        android:textColor="@color/status_debris"
                        android:textSize="36sp" 
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/status_debris_text"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="?attr/textSizeBody"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Button 5: Supply -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSupply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_hint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧"
                        android:textColor="@color/status_supply"
                        android:textSize="36sp" 
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/status_supply_text"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="?attr/textSizeBody"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Button 6: Battery -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_hint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔋"
                        android:textColor="@color/status_low_battery"
                        android:textSize="36sp" 
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/status_low_battery_text"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="?attr/textSizeBody"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Mesaj kutusu butonu yukarı taşındı -->

</androidx.coordinatorlayout.widget.CoordinatorLayout>
