<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: Back Button + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="32dp">
            
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:background="@drawable/back_button_bg"
                android:src="@drawable/ic_back_chevron"
                app:tint="?android:attr/textColorPrimary" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sağlık Bilgilerim"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="?attr/textSizeH1"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bu bilgiler afet anında atacağınız yardım mesajına otomatik eklenir ve kurtarma ekiplerinin size daha hazırlıklı ulaşmasını sağlar."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp"/>

        <!-- Kan Grubu (Dropdown) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Kan Grubu"
            app:hintTextColor="?attr/colorSecondary"
            app:boxStrokeColor="?attr/colorSecondary"
            app:boxBackgroundColor="?attr/colorSurface"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etBloodType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="?attr/textSizeBody"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Kronik Hastalık -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Kronik Hastalıklar"
            app:hintTextColor="?attr/colorSecondary"
            app:boxStrokeColor="?attr/colorSecondary"
            app:boxBackgroundColor="?attr/colorSurface"
            app:helperText="Yoksa boş bırakabilirsiniz"
            app:helperTextTextColor="@color/text_hint"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChronicDisease"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="?attr/textSizeBody"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Kullanılan İlaçlar -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:hint="Düzenli Kullanılan İlaçlar"
            app:hintTextColor="?attr/colorSecondary"
            app:boxStrokeColor="?attr/colorSecondary"
            app:boxBackgroundColor="?attr/colorSurface"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMedication"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="?attr/textSizeBody"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveHealth"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="BİLGİLERİ GÜNCELLE"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:backgroundTint="#3B82F6" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>
