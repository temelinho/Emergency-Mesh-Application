<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="24dp"
    android:gravity="center">

    <!-- Üst Bar: Geri Dönüş -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:layout_marginBottom="40dp"
        android:layout_marginTop="16dp">
        
        <ImageView
            android:id="@+id/btnBackToNormal"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#666666"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Çıkış" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <!-- GÜVENDEYİM BUTONU -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnElderlySafe"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="#10B981"
        app:cardCornerRadius="24dp"
        app:strokeWidth="0dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅"
                android:textSize="36sp"
                android:layout_marginBottom="8dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GÜVENDEYİM"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- YARDIM LAZIM BUTONU -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnElderlyEmergency"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        app:cardBackgroundColor="#EF4444"
        app:cardCornerRadius="24dp"
        app:strokeWidth="0dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🆘"
                android:textSize="36sp"
                android:layout_marginBottom="8dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YARDIM LAZIM"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Onaylamak için basılı tutun"
        android:textColor="#888888"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

</LinearLayout>
